    "# Домашняя работа 2 — качество данных"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "53f8d0a2",
   "metadata": {},
   "source": [
    "## Подготовка"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "233ce9cd",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "import pandas as pd\n",
    "from pandas.testing import assert_frame_equal\n",
    "\n",
    "DATA = Path(\"../data\")\n",
    "LOCAL = Path(\"../data\")\n",
    "WORK = Path(\"../results\")\n",
    "WORK.mkdir(exist_ok=True)\n",
    "print(\"pandas\", pd.__version__)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a1b2c3d4",
   "metadata": {},
   "source": [
    "## Независимая загрузка"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e5f6g7h8",
   "metadata": {},
   "outputs": [],
   "source": [
    "decisions = pd.read_csv(\n",
    "    DATA / \"decisions.csv\", dtype={\"lei\": \"string\", \"county_code\": \"string\"}\n",
    ")\n",
    "export = pd.read_csv(LOCAL / \"training_export.csv\", dtype=\"string\")\n",
    "raw_copy = export.copy(deep=True)\n",
    "print(decisions.shape, export.shape)\n",
    "print(export.dtypes)\n",
    "export.head(5)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "i9j0k1l2",
   "metadata": {},
   "source": [
    "## H1. Собственная функция очистки"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "m3n4o5p6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def clean_export(source):\n",
    "    df = source.copy(deep=True)\n",
    "    original_cols = list(source.columns)\n",
    "    audit = {\n",
    "        'input': len(df),\n",
    "        'replays': 0,\n",
    "        'clean': 0,\n",
    "        'quarantine': 0,\n",
    "        'parse_errors': 0\n",
    "    }\n",
    "    df['_row_key'] = pd.to_numeric(df['source_row'], errors='coerce')\n",
    "    drop_idx = []\n",
    "    known = df['_row_key'].notna()\n",
    "    for key, group in df.loc[known].groupby('_row_key', sort=False):\n",
    "        if len(group) > 1:\n",
    "            unique = group.drop_duplicates(subset=original_cols)\n",
    "            assert len(unique) == 1, f'Конфликт версий для source_row {key}'\n",
    "            drop_idx.extend(group.index[1:])\n",
    "    dedup = df.drop(index=drop_idx).drop(columns=['_row_key'])\n",
    "    audit['replays'] = len(drop_idx)\n",
    "    row_raw = dedup['source_row']\n",
    "    action_raw = dedup['action_taken']\n",
    "    loan_raw = dedup['loan_amount']\n",
    "    income_raw = dedup['income']\n",
    "    county_raw = dedup['county_code']\n",
    "    row_num = pd.to_numeric(row_raw, errors='coerce')\n",
    "    action_num = pd.to_numeric(action_raw, errors='coerce')\n",
    "    loan_num = pd.to_numeric(loan_raw, errors='coerce')\n",
    "    income_num = pd.to_numeric(income_raw, errors='coerce')\n",
    "    county_norm = county_raw.str.strip()\n",
    "    parse_errors = 0\n",
    "    for raw_col, num_col in ((row_raw, row_num), (action_raw, action_num),\n",
    "                             (loan_raw, loan_num), (income_raw, income_num)):\n",
    "        parse_errors += int((raw_col.notna() & num_col.isna()).sum())\n",
    "    audit['parse_errors'] = parse_errors\n",
    "    reasons = []\n",
    "    for idx in dedup.index:\n",
    "        r = []\n",
    "        if pd.isna(row_num.loc[idx]):\n",
    "            r.append('некорректный source_row')\n",
    "        if pd.isna(action_num.loc[idx]) or action_num.loc[idx] not in (1, 2, 3):\n",
    "            r.append('некорректный action_taken')\n",
    "        if pd.isna(loan_num.loc[idx]) or loan_num.loc[idx] <= 0:\n",
    "            r.append('некорректный сумма кредита')\n",
    "        county = county_norm.loc[idx]\n",
    "        if pd.isna(county) or county != '11001':\n",
    "            r.append('некорректный территория')\n",
    "        if pd.notna(income_raw.loc[idx]) and pd.isna(income_num.loc[idx]):\n",
    "            r.append('некорректный доход')\n",
    "        reasons.append(';'.join(r))\n",
    "    reasons = pd.Series(reasons, index=dedup.index, dtype='object')\n",
    "    clean_mask = reasons == ''\n",
    "    clean = dedup.loc[clean_mask, original_cols].copy()\n",
    "    clean['source_row'] = row_num[clean_mask].astype('Int64')\n",
    "    clean['action_taken'] = action_num[clean_mask].astype('Int64')\n",
    "    clean['loan_amount'] = loan_num[clean_mask].astype('float')\n",
    "    clean['income'] = income_num[clean_mask].astype('float')\n",
    "    clean['county_code'] = county_norm[clean_mask]\n",
    "    quarantine = dedup.loc[~clean_mask, original_cols].copy()\n",
    "    quarantine['reason'] = reasons[~clean_mask]\n",
    "    audit['clean'] = len(clean)\n",
    "    audit['quarantine'] = len(quarantine)\n",
    "    assert audit['input'] == audit['replays'] + audit['clean'] + audit['quarantine']\n",
    "    return clean, quarantine, audit"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q7r8s9t0",
   "metadata": {},
   "source": [
    "## H2. Год и известный доход"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "u1v2w3x4",
   "metadata": {},
   "outputs": [],
   "source": [
    "clean, quarantine, audit = clean_export(export)\n",
    "print(f\"Журнал: {audit}\")\n",
    "year_ok = clean['activity_year'].eq('2023').fillna(False).all()\n",
    "print(f\"Год везде 2023: {year_ok}\")\n",
    "n_total = len(clean)\n",
    "known_income = int(clean['income'].notna().sum())\n",
    "unknown_income = int(clean['income'].isna().sum())\n",
    "mean_income = clean['income'].mean()\n",
    "print(f\"Всего записей: {n_total}\")\n",
    "print(f\"Известный доход: {known_income}\")\n",
    "print(f\"Неизвестный доход: {unknown_income}\")\n",
    "print(f\"Средний доход: {mean_income} тысяч USD\")\n",
    "print(\"Единица измерения: тысячи USD\")\n",
    "balance_ok = audit['input'] == audit['replays'] + audit['clean'] + audit['quarantine']\n",
    "print(f\"Баланс сходится: {balance_ok}\")\n",
    "assert year_ok\n",
    "assert balance_ok\n",
    "assert_frame_equal(export, raw_copy)\n",
    "print('Вход не изменился')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "y5z6a7b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "wrong_year = export.copy(deep=True)\n",
    "wrong_year.loc[wrong_year.index, 'activity_year'] = '2022'\n",
    "clean_wrong, _, _ = clean_export(wrong_year)\n",
    "year_ok_wrong = clean_wrong['activity_year'].eq('2023').fillna(False).all()\n",
    "print(f\"Проверка года на испорченных данных: {year_ok_wrong}\")\n",
    "assert not year_ok_wrong\n",
    "assert_frame_equal(export, raw_copy)\n",
    "print('export сохранён')"
   ]
  },
